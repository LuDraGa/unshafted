{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["CEB_*", "CLI_CEB_*"],
  "globalDependencies": [".env"],
  "concurrency": "12",
  "tasks": {
    "ready": {
      "dependsOn": ["^ready"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["ready"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["ready", "^ready", "^build"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false
    },
    // No `^ready`, and that was checked rather than assumed. Both workspace packages point `types`
    // at their source entry (`index.mts`, `index.ts`), so TypeScript reads them without a build;
    // `pnpm type-check` passes 12/12 on a tree with every `dist/` deleted. `lint` used to be the
    // exception here, because it executed `tailwind.config.ts`; Tailwind 4 removed those files, so
    // it no longer is.
    "type-check": {
      "cache": false
    },
    /*
     * `^ready` because `@extension/storage`'s suite imports `@extension/unshafted-core` at RUNTIME,
     * and that resolves through `main: dist/index.mjs` — built output, not source. On a tree with
     * no `dist/` the import throws before any test registers, so the run reports *1 failing test*
     * rather than 13, which reads like one broken case instead of a suite that never executed.
     * `unshafted-core`'s own suite imports source and passes either way, so the need is invisible
     * unless you look at storage specifically.
     *
     * `cache: false` matches `lint` and `type-check`. There is no remote cache configured, so
     * caching would buy nothing in CI while making a stale green possible if inputs were ever
     * declared wrong.
     */
    "test": {
      "dependsOn": ["^ready"],
      "cache": false
    },
    /*
     * No `^ready` any more, and that was measured rather than assumed. It was there because every
     * `tailwind.config.ts` under `pages/` imported `withUI` from `@extension/ui`s built output, so
     * unbuilt tree the Tailwind config failed to load, prettier-plugin-tailwindcss fell back to a
     * parser that could not read JSX, and eslint exited 2 with a ParseError instead of lint errors
     * (#25).
     *
     * Tailwind 4 deleted that coupling (#43). There are no `tailwind.config.ts` files left and no
     * `withUI`; the shared layer is `packages/ui/global.css`, which prettier-plugin-tailwindcss
     * reads as source via `tailwindStylesheet` in `.prettierrc`. Nothing in `lint` executes a
     * workspace package's build output now — checked by deleting every `dist/` and running
     * `eslint .` in all 11 packages, which passes.
     */
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": false
    },
    /*
     * The verdict half of `format`, and the one CI runs. No `dependsOn`: checking a package's own
     * files needs nothing built or formatted first, and `^format` here would make a *check* mutate
     * the tree it is checking.
     *
     * `cache: false` for the reason `lint`, `type-check` and `test` carry it — there is no remote
     * cache configured, so caching buys nothing in CI while making a stale green possible. Note
     * the root `format` script also passes prettier's own `--cache`; this deliberately does not.
     * A fix loop may trust a cache, a required status check may not.
     */
    "format:check": {
      "cache": false
    },
    "clean:node_modules": {
      "dependsOn": ["^clean:node_modules"],
      "cache": false
    },
    "clean:turbo": {
      "dependsOn": ["^clean:turbo"],
      "cache": false
    },
    "clean:bundle": {
      "dependsOn": ["^clean:bundle"],
      "cache": false
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  }
}
