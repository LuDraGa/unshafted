{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["CEB_*", "CLI_CEB_*"],
  "globalDependencies": [".env"],
  "concurrency": "12",
  "tasks": {
    "ready": {
      "dependsOn": ["^ready"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["ready"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["ready", "^ready", "^build"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false
    },
    "type-check": {
      "cache": false
    },
    // `^ready` for the same reason `build` needs it. `@extension/ui` resolves through its built
    // `dist/`, and every `pages/*/tailwind.config.ts` imports `withUI` from it — so on a tree that
    // has not been built the Tailwind config fails to load, prettier-plugin-tailwindcss falls back
    // to a parser that cannot read JSX, and eslint exits 2 with a ParseError instead of reporting
    // lint errors. Only `@extension/shared` builds itself on postinstall, so this passed for anyone
    // who had run a build and failed on every clean checkout — invisibly, until the PR checks
    // started reading the repository (#25).
    "lint": {
      "dependsOn": ["^ready"],
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["^ready"],
      "cache": false
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": false
    },
    "clean:node_modules": {
      "dependsOn": ["^clean:node_modules"],
      "cache": false
    },
    "clean:turbo": {
      "dependsOn": ["^clean:turbo"],
      "cache": false
    },
    "clean:bundle": {
      "dependsOn": ["^clean:bundle"],
      "cache": false
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  }
}
