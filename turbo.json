{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["CEB_*", "CLI_CEB_*"],
  "globalDependencies": [".env"],
  "concurrency": "12",
  "tasks": {
    "ready": {
      "dependsOn": ["^ready"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["ready"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["ready", "^ready", "^build"],
      "outputs": ["../../dist/**", "dist/**"],
      "cache": false
    },
    // No `^ready`, and that was checked rather than assumed. Both workspace packages point `types`
    // at their source entry (`index.mts`, `index.ts`), so TypeScript reads them without a build;
    // `pnpm type-check` passes 12/12 on a tree with every `dist/` deleted. Nothing here executes a
    // workspace package the way `lint` executes `tailwind.config.ts`, which is what forced `^ready`
    // there.
    "type-check": {
      "cache": false
    },
    /*
     * `^ready` because `@extension/storage`'s suite imports `@extension/unshafted-core` at RUNTIME,
     * and that resolves through `main: dist/index.mjs` — built output, not source. On a tree with
     * no `dist/` the import throws before any test registers, so the run reports *1 failing test*
     * rather than 13, which reads like one broken case instead of a suite that never executed.
     * `unshafted-core`'s own suite imports source and passes either way, so the need is invisible
     * unless you look at storage specifically.
     *
     * `cache: false` matches `lint` and `type-check`. There is no remote cache configured, so
     * caching would buy nothing in CI while making a stale green possible if inputs were ever
     * declared wrong.
     */
    "test": {
      "dependsOn": ["^ready"],
      "cache": false
    },
    // `^ready` for the same reason `build` needs it. `@extension/ui` resolves through its built
    // `dist/`, and every `pages/*/tailwind.config.ts` imports `withUI` from it — so on a tree that
    // has not been built the Tailwind config fails to load, prettier-plugin-tailwindcss falls back
    // to a parser that cannot read JSX, and eslint exits 2 with a ParseError instead of reporting
    // lint errors. Only `@extension/shared` builds itself on postinstall, so this passed for anyone
    // who had run a build and failed on every clean checkout — invisibly, until the PR checks
    // started reading the repository (#25).
    "lint": {
      "dependsOn": ["^ready"],
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["^ready"],
      "cache": false
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": false
    },
    "clean:node_modules": {
      "dependsOn": ["^clean:node_modules"],
      "cache": false
    },
    "clean:turbo": {
      "dependsOn": ["^clean:turbo"],
      "cache": false
    },
    "clean:bundle": {
      "dependsOn": ["^clean:bundle"],
      "cache": false
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  }
}
